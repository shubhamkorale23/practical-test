# Application Server Configuration
HOST=0.0.0.0
PORT=4000
DEBUG=False

# LLM Platform Configuration
# Provider options: "auto" (default, detects available key), "gemini", "openai", "anthropic", "heuristic"
LLM_PROVIDER=auto

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Multi-Platform Posting Configuration
# When MOCK_POSTING=True, unconfigured platforms run in sandbox simulation mode (ideal for local testing).
# Set MOCK_POSTING=False to enforce live credentials.
MOCK_POSTING=True

# 1. Discord Webhook URL (Format: https://discord.com/api/webhooks/{id}/{token})
DISCORD_WEBHOOK_URL=

# 2. Telegram Bot API (Token from @BotFather, Chat ID from @userinfobot or channel username)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. Slack Incoming Webhook URL (Format: https://hooks.slack.com/services/...)
SLACK_WEBHOOK_URL=

# 4. Mastodon Statuses API
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# 5. Dev.to / Forem API Key (From dev.to settings -> extensions)
DEVTO_API_KEY=
